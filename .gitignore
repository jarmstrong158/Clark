# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Virtualenvs
.venv/
venv/

# Secrets
.env

# Trained model weights — license separately
*.pth
*.pt
*.bak

# Runtime data — facility configs, logs, checkpoints, per-facility state
clark/data/checkpoints/
clark/data/logs/
clark/data/facilities/
# User-authored facility YAMLs (wizard /generate output, wizard
# sessions). Template configs in clark/data/configs/ stay tracked;
# only per-user state under user/ is ignored.
clark/data/configs/user/

# IDE / editor noise
.idea/
.vscode/
*.swp
.DS_Store

# Tooling local state
.context/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local-only test outputs
*.log

# Profiler measurement logs (transient run artifacts)
proflog_*.txt

# Operator scratch scripts/logs (intentionally untracked)
tmp_*
.cambium/
